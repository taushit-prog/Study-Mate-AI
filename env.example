# ─────────────────────────────────────────────
# IBM Watsonx.ai Configuration
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# IBM Cloud API Key — generate at https://cloud.ibm.com/iam/apikeys
IBM_API_KEY=

# Watsonx.ai Project ID — find in your project's Manage > General page
WATSONX_PROJECT_ID=

# Watsonx.ai region URL — MUST match the region your project/runtime is in
# Sydney   : https://au-syd.ml.cloud.ibm.com
# Dallas   : https://us-south.ml.cloud.ibm.com
# Frankfurt: https://eu-de.ml.cloud.ibm.com
# London   : https://eu-gb.ml.cloud.ibm.com
# Tokyo    : https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://au-syd.ml.cloud.ibm.com

# Flask secret key — any random string
FLASK_SECRET_KEY=change-this-random-string

FLASK_ENV=development
